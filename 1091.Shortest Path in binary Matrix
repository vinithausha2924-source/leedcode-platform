
class Solution {
    public int shortestPathBinaryMatrix(int[][] grid) {
        int n = grid.length;
        if (grid[0][0] != 0 || grid[n-1][n-1] != 0) return -1;

        Queue<int[]> q = new LinkedList<>();
        q.add(new int[]{0, 0, 1});
        grid[0][0] = 1;

        int[] d = {-1, 0, 1};

        while (!q.isEmpty()) {
            int[] a = q.poll();
            int r = a[0], c = a[1], len = a[2];
            if (r == n-1 && c == n-1) return len;

            for (int x : d)
                for (int y : d) {
                    int nr = r + x, nc = c + y;
                    if (nr >= 0 && nc >= 0 && nr < n && nc < n
                        && grid[nr][nc] == 0) {
                        grid[nr][nc] = 1;
                        q.add(new int[]{nr, nc, len + 1});
                    }
                }
        }
        return -1;
    }
}
